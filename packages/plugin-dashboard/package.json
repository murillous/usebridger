{
  "name": "@usebridger/plugin-dashboard",
  "version": "0.1.0",
  "description": "Plugin oficial do Bridger: dashboard web com autenticação, status da conexão, QR, logs ao vivo e WebSocket.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murillous/usebridger.git",
    "directory": "packages/plugin-dashboard"
  },
  "homepage": "https://github.com/murillous/usebridger/tree/develop/packages/plugin-dashboard/docs#readme",
  "bugs": "https://github.com/murillous/usebridger/issues",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "@usebridger/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown && vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@usebridger/core": "workspace:^"
  },
  "devDependencies": {
    "@fontsource-variable/funnel-display": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@usebridger/plugin-metrics": "workspace:*",
    "@usebridger/testing": "workspace:*",
    "@vitejs/plugin-react": "^6.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
