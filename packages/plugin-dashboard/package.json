{
  "name": "@usebridger/plugin-dashboard",
  "version": "0.4.0",
  "description": "Plugin oficial do Bridger: app web sobre a API HTTP do core (conexão, logs, plugins, config, auditoria, usuários e recursos de plugins).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murillous/usebridger.git",
    "directory": "packages/plugin-dashboard"
  },
  "homepage": "https://github.com/murillous/usebridger/tree/develop/packages/plugin-dashboard/docs#readme",
  "bugs": "https://github.com/murillous/usebridger/issues",
  "type": "module",
  "imports": {
    "#web/*": "./web/src/*",
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "@usebridger/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown && vite build --config web/vite.config.ts",
    "gen:api": "pnpm dlx --package typescript@5 --package openapi-typescript@7.13.0 openapi-typescript ../core/src/api/__snapshots__/openapi.json -o web/src/lib/api-types.d.ts"
  },
  "dependencies": {
    "@usebridger/core": "workspace:^"
  },
  "devDependencies": {
    "@fontsource-variable/funnel-display": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@rjsf/core": "6.11.0",
    "@rjsf/utils": "6.11.0",
    "@rjsf/validator-ajv8": "6.11.0",
    "@tanstack/react-query": "5.105.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@usebridger/testing": "workspace:*",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.3",
    "openapi-fetch": "0.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
