{
  "openapi": "3.2.0",
  "info": {
    "title": "Bridger API",
    "version": "0.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Estado das sessões",
        "tags": [
          "core"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Entra com e-mail e senha; a sessão vai no cookie `bridger_session`",
        "tags": [
          "auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 320
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 1024
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "owner",
                            "admin",
                            "viewer"
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "active",
                            "disabled"
                          ]
                        },
                        "createdAt": {
                          "type": "string"
                        },
                        "lastLoginAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "mustChangePassword": {
                          "type": "boolean"
                        },
                        "pendingInvite": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "email",
                        "role",
                        "status",
                        "createdAt",
                        "lastLoginAt",
                        "mustChangePassword",
                        "pendingInvite"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "user"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
