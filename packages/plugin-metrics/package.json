{
  "name": "@usebridger/plugin-metrics",
  "version": "0.2.0",
  "description": "Plugin oficial do Bridger: serviço de métricas declarativo sobre o prom-client, histórico por hora e dia e GET /metrics do bot.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murillous/usebridger.git",
    "directory": "packages/plugin-metrics"
  },
  "homepage": "https://github.com/murillous/usebridger/tree/develop/packages/plugin-metrics/docs#readme",
  "bugs": "https://github.com/murillous/usebridger/issues",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "@usebridger/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@usebridger/core": "workspace:^",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@usebridger/testing": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
