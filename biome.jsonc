{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // Convenções do Bridger (BRIDGER_PLAN.md §8): só named exports...
        "noDefaultExport": "error",
        // ...nenhum process.env fora da camada de config (ver overrides)...
        "noProcessEnv": "error",
        // ...e imports entre pacotes pelo nome @usebridger/*, nunca subindo diretórios.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**", ".."],
                "message": "Import relativo ascendente: importe pelo pacote (@usebridger/*) ou reorganize o módulo."
              }
            ]
          }
        }
      },
      "complexity": {
        // Conflita com noPropertyAccessFromIndexSignature do tsconfig, que exige env['X'].
        "useLiteralKeys": "off"
      },
      "suspicious": {
        // Nunca engolir erros: bloco vazio (incluindo catch {}) é erro.
        "noEmptyBlockStatements": "error"
      }
    }
  },
  "plugins": [
    "./tooling/biome/no-swallowed-catch.grit",
    {
      // Logs do kernel só por evento (ADR 0118); os testes e a implementação do logger ficam de fora.
      "path": "./tooling/biome/log-event.grit",
      "includes": [
        "**/src/**/*.ts",
        "!**/*.test.ts",
        "!**/*.test-support.ts",
        "!**/core/src/logger/**"
      ]
    }
  ],
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      // Arquivos de config de ferramentas (vitest, tsdown, astro...) exigem export default; o astro.config.mjs só é lido assim.
      "includes": ["**/*.config.ts", "**/*.config.mts", "**/*.config.js", "**/*.config.mjs"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // O Biome só lê o frontmatter do .astro e não vê o uso no template: ele acusaria import e variável "sem uso".
      "includes": ["**/*.astro"],
      "linter": {
        "rules": { "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" } }
      }
    },
    {
      // A camada de config é o único lugar que lê process.env.
      "includes": ["**/src/config.ts", "**/src/config/**"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    }
  ]
}
