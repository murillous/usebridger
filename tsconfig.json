{
  // Solution da raiz: `pnpm typecheck` roda `tsc -b` nos arquivos de config da raiz e em todos
  // os pacotes listados em `references` — ao criar um pacote, adicione-o lá.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "noEmit": true
  },
  // Scripts de pacote (fora do `src/` de cada um) também passam pelo typecheck daqui.
  "include": ["*.config.ts", "packages/*/scripts", "tooling/*.ts", "site/scripts"],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/transport-baileys" },
    { "path": "packages/transport-web" },
    { "path": "packages/storage-sqlite" },
    { "path": "packages/storage-postgres" },
    { "path": "packages/testing" },
    { "path": "packages/create-plugin" },
    { "path": "bench" },
    { "path": "examples/primeiro-bot" },
    { "path": "examples/primeiro-bot-web" },
    { "path": "examples/primeiro-plugin" },
    { "path": "examples/conversa-guiada" },
    { "path": "examples/configuracao" },
    { "path": "examples/producao" }
  ]
}
